# Copy to .env (git-ignored) and adjust. Variables are documented in docs/10-local-dev.md.
# Local development values only; never reuse them elsewhere.
# The old PAYRUDDER_* spelling of a setting still works for the services (with a warning); PAYRUDDER_* wins when both are set (docs/adr/0022).

# --- compose host ports that often clash with other local stacks ---
PAYRUDDER_PG_HOST_PORT=42432
PAYRUDDER_CONSOLE_HOST_PORT=42080

# --- common to every service (pkg/config.Base) ---
PAYRUDDER_ENV=local
PAYRUDDER_VERSION=dev
PAYRUDDER_LOG_LEVEL=info
PAYRUDDER_OTLP_ENDPOINT=localhost:42317

# --- gateway / plans-svc (run from the IDE against make up-infra) ---
PAYRUDDER_OPERATOR_TOKEN=local-operator-token-change-me-0123456789
PAYRUDDER_ALLOWED_ENVIRONMENTS=sandbox,live
PAYRUDDER_REDIS_URL=redis://localhost:42379/0
PAYRUDDER_PLANS_ADDR=dns:///localhost:42701
PAYRUDDER_PG_APP_DSN=postgres://plans_app:plans_app_local@localhost:42432/plans_db
PAYRUDDER_PG_SYSTEM_DSN=postgres://plans_system:plans_system_local@localhost:42432/plans_db
PAYRUDDER_PG_MIGRATOR_DSN=postgres://plans_migrator:plans_migrator_local@localhost:42432/plans_db
PAYRUDDER_MIGRATE_ON_START=true

# --- ingest-svc (plans-svc variables above apply to the gateway; ingest-svc has its own database and roles) ---
PAYRUDDER_INGEST_ADDR=dns:///localhost:42702
PAYRUDDER_KAFKA_BROKERS=localhost:42092
# PAYRUDDER_RELAY_WORKERS=2
# PAYRUDDER_RELAY_BATCH_SIZE=1000
# PAYRUDDER_MAX_OUTBOX_DEPTH=5000000
# ingest-svc DSNs: same shape as plans-svc with ingest_app / ingest_system / ingest_migrator and ingest_db

# --- added by later phases (shapes from docs/10-local-dev.md) ---
# S3_ENDPOINT=http://localhost:42901
# S3_REGION=us-east-1
# S3_BUCKET=invoices
# S3_FORCE_PATH_STYLE=true
# MOCKPSP_URL=http://localhost:42890
# PAYMENTS_LIVE_PROVIDER=mockpsp

# Payment providers (phase 14). The key seals tenants' provider credentials at rest (32 bytes, base64); the token is the shared
# secret between the gateway and payments-worker. The compose defaults are for the local stack only.
# PAYRUDDER_SECRETS_KEY=$(openssl rand -base64 32)
# PAYRUDDER_PAYMENTS_INTERNAL_TOKEN=$(openssl rand -hex 24)
