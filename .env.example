# Copy to .env (git-ignored) and adjust. Variables are documented in docs/10-local-dev.md.
# Local development values only; never reuse them elsewhere.

# --- compose host ports that often clash with other local stacks ---
QUOTIFY_PG_HOST_PORT=5432
QUOTIFY_CONSOLE_HOST_PORT=8080

# --- common to every service (pkg/config.Base) ---
QUOTIFY_ENV=local
QUOTIFY_VERSION=dev
QUOTIFY_LOG_LEVEL=info
QUOTIFY_OTLP_ENDPOINT=localhost:4317

# --- gateway / plans-svc (run from the IDE against make up-infra) ---
QUOTIFY_OPERATOR_TOKEN=local-operator-token-change-me-0123456789
QUOTIFY_ALLOWED_ENVIRONMENTS=sandbox,live
QUOTIFY_REDIS_URL=redis://localhost:6379/0
QUOTIFY_PLANS_ADDR=dns:///localhost:7001
QUOTIFY_PG_APP_DSN=postgres://plans_app:plans_app_local@localhost:5432/plans_db
QUOTIFY_PG_SYSTEM_DSN=postgres://plans_system:plans_system_local@localhost:5432/plans_db
QUOTIFY_PG_MIGRATOR_DSN=postgres://plans_migrator:plans_migrator_local@localhost:5432/plans_db
QUOTIFY_MIGRATE_ON_START=true

# --- added by later phases (shapes from docs/10-local-dev.md) ---
# S3_ENDPOINT=http://localhost:9001
# S3_REGION=us-east-1
# S3_BUCKET=invoices
# S3_FORCE_PATH_STYLE=true
# MOCKPSP_URL=http://localhost:8090
# PAYMENTS_LIVE_PROVIDER=mockpsp
