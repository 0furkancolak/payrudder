{
  "name": "@payrudder/sdk",
  "version": "0.0.0",
  "description": "TypeScript/JavaScript SDK of the Payrudder billing API (pre-release)",
  "keywords": [
    "payrudder",
    "billing",
    "usage-based-billing",
    "metering",
    "sdk"
  ],
  "homepage": "https://github.com/0furkancolak/payrudder/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/0furkancolak/payrudder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0furkancolak/payrudder.git",
    "directory": "sdk/typescript"
  },
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsup",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run generate:check && npm run typecheck && npm run lint && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
