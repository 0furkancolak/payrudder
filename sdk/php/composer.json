{
    "name": "payrudder/payrudder-php",
    "description": "PHP SDK for the Payrudder usage-based billing API (tenant API and webhook verification).",
    "type": "library",
    "license": "Elastic-2.0",
    "keywords": ["payrudder", "billing", "usage-based", "sdk"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.20",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-curl": "Used by the built-in transport",
        "psr/http-client": "To send requests through your own PSR-18 client",
        "psr/http-factory": "To send requests through your own PSR-18 client",
        "php-http/discovery": "To find a PSR-18 client and PSR-17 factories automatically"
    },
    "autoload": {
        "psr-4": {
            "Payrudder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payrudder\\Tests\\": "tests/",
            "Payrudder\\Tools\\": "tools/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "generate": [
            "php tools/generate.php",
            "@cs:fix"
        ],
        "cs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --dry-run --diff",
        "cs:fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
