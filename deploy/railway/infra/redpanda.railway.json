{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/images/redpanda/Dockerfile",
    "watchPatterns": [
      "/deploy/railway/images/redpanda/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/v1/status/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "requiredMountPath": "/var/lib/redpanda/data"
  }
}
