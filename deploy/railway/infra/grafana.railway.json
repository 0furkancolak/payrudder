{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/images/grafana/Dockerfile",
    "watchPatterns": [
      "/deploy/railway/images/grafana/**",
      "/deploy/grafana/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "sleepApplication": true
  }
}
