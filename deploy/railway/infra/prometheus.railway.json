{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/images/prometheus/Dockerfile",
    "watchPatterns": [
      "/deploy/railway/images/prometheus/**",
      "/deploy/prometheus/rules/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/-/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "requiredMountPath": "/prometheus",
    "numReplicas": 1
  }
}
