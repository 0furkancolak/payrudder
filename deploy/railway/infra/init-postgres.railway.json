{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/images/postgres-init/Dockerfile",
    "watchPatterns": [
      "/deploy/railway/images/postgres-init/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
