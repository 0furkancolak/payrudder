{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/images/pgbouncer/Dockerfile",
    "watchPatterns": [
      "/deploy/railway/images/pgbouncer/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
