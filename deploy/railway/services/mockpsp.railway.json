{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/go.Dockerfile",
    "watchPatterns": [
      "/pkg/**",
      "/gen/go/**",
      "/tools/mockpsp/**",
      "/deploy/railway/go.Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 30
  }
}
