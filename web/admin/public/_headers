# Applied by Workers static assets to the files the platform serves (the Worker's own answers are API responses).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Vite hashes the file names under /assets: they never change, so they are cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry points are small and must show a new deploy at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
