# Serves the built console and forwards /gw/* to the gateway (GATEWAY_URL), so the browser talks to one origin and the gateway
# needs no CORS. The gateway is resolved per request (variable + resolver) because its address changes when it is recreated.
server {
  # PORT is injected by platforms such as Railway (the Dockerfile defaults it to 3001); [::] makes the console reachable over an IPv6 private network.
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 2m;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /gw/ {
    set $gateway "${GATEWAY_URL}";
    rewrite ^/gw/(.*)$ /$1 break;
    proxy_pass $gateway;
    proxy_set_header Host $host;
    # Overwritten, not appended: the console is the edge, so the gateway can count sign-in attempts per visitor (QUOTIFY_TRUST_FORWARDED_FOR).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_pass_request_headers on;
    proxy_http_version 1.1;
    proxy_read_timeout 30s;
  }

  # BRAND_NAME is the product name shown in place of the default (no quotes in it). Local convenience: PREFILL_PLAYGROUND=true pre-fills the operator playground form (false by default). No credential is ever served here.
  location = /env.js {
    default_type application/javascript;
    add_header Cache-Control "no-store";
    return 200 'window.__QUOTIFY__={prefill:${PREFILL_PLAYGROUND},brand:"${BRAND_NAME}",demo:${QUOTIFY_DEMO}};';
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
