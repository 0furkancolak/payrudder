{
  "name": "quotify-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Operator console for Quotify (docs/phases/phase-12-admin-ui.md)",
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi/v1.yaml -o src/lib/schema.d.ts",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22" }
}
