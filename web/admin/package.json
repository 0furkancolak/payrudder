{
  "name": "payrudder-admin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Operator console for Payrudder: Vue 3, TanStack Router and Query, feature-based (docs/13-admin-ui.md)",
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi/v1.yaml -o src/shared/api/schema.d.ts",
    "dev": "vite --port 42301",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 42301",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:mock": "playwright test -c playwright.mock.config.ts",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy:staging": "npm run build && wrangler deploy --env staging",
    "cf:deploy": "npm run build && wrangler deploy --env production",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@lucide/vue": "1.59.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query": "5.104.4",
    "@tanstack/vue-router": "1.170.41",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
